<Window x:Class="MISILNative.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MISILNative.Views"
        Title="MISIL" Height="720" Width="1080"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBgPrimary}">
    
    <Grid>
        <!-- Loading State -->
        <Grid x:Name="LoadingContainer" Visibility="Visible" Background="{StaticResource BrushBgPrimary}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="64" Height="64" Background="{StaticResource BrushAccent}" CornerRadius="16" HorizontalAlignment="Center" Margin="0,0,0,18">
                    <TextBlock Text="M" FontWeight="Bold" FontSize="36" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Cargando MISIL..." FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Onboarding View -->
        <views:OnboardingView x:Name="OnboardingContainer" Visibility="Collapsed" />

        <!-- Main Shell View -->
        <views:MainShellView x:Name="MainShellContainer" Visibility="Collapsed" />
    </Grid>
</Window>
