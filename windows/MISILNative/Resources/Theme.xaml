<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- MISIL Official Color Palette -->
    <Color x:Key="ColorBgPrimary">#150000</Color>
    <Color x:Key="ColorBgSecondary">#1E0000</Color>
    <Color x:Key="ColorBgSurface">#260000</Color>
    <Color x:Key="ColorBgHover">#330000</Color>
    <Color x:Key="ColorBgActive">#4D0000</Color>
    <Color x:Key="ColorAccent">#FF3737</Color>
    <Color x:Key="ColorAccentHover">#FF5555</Color>
    <Color x:Key="ColorAccentDark">#CC2222</Color>
    <Color x:Key="ColorDanger">#EF5350</Color>
    <Color x:Key="ColorSuccess">#45D483</Color>
    <Color x:Key="ColorTextPrimary">#F5F5F5</Color>
    <Color x:Key="ColorTextSecondary">#8B9BAB</Color>
    <Color x:Key="ColorTextMuted">#6C7883</Color>
    <Color x:Key="ColorBorder">#18FFFFFF</Color>

    <!-- Solid Color Brushes -->
    <SolidColorBrush x:Key="BrushBgPrimary" Color="{StaticResource ColorBgPrimary}" />
    <SolidColorBrush x:Key="BrushBgSecondary" Color="{StaticResource ColorBgSecondary}" />
    <SolidColorBrush x:Key="BrushBgSurface" Color="{StaticResource ColorBgSurface}" />
    <SolidColorBrush x:Key="BrushBgHover" Color="{StaticResource ColorBgHover}" />
    <SolidColorBrush x:Key="BrushBgActive" Color="{StaticResource ColorBgActive}" />
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="BrushAccentHover" Color="{StaticResource ColorAccentHover}" />
    <SolidColorBrush x:Key="BrushAccentDark" Color="{StaticResource ColorAccentDark}" />
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BrushGlass" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="BrushGlassHover" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="BrushAccentGlass" Color="#2AFF3737" />
    <SolidColorBrush x:Key="BrushAccentBorder" Color="#66FF3737" />

    <LinearGradientBrush x:Key="BrushAccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF3737" Offset="0" />
        <GradientStop Color="#CC2222" Offset="1" />
    </LinearGradientBrush>

    <!-- Bundled MISIL type system -->
    <FontFamily x:Key="FontHeadline">pack://application:,,,/MISIL;component/Resources/Fonts/#Space Grotesk</FontFamily>
    <FontFamily x:Key="FontBody">pack://application:,,,/MISIL;component/Resources/Fonts/#Inter</FontFamily>
    <FontFamily x:Key="FontLabel">pack://application:,,,/MISIL;component/Resources/Fonts/#Plus Jakarta Sans</FontFamily>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
    </Style>

    <!-- Corner Radii -->
    <CornerRadius x:Key="RadiusSm">10</CornerRadius>
    <CornerRadius x:Key="RadiusMd">14</CornerRadius>
    <CornerRadius x:Key="RadiusLg">18</CornerRadius>
    <CornerRadius x:Key="RadiusXl">24</CornerRadius>

    <!-- Primary Button Style -->
    <Style x:Key="MISILPrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrushAccentGlass}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="{StaticResource FontLabel}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccentBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusSm}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#42FF3737" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource BrushAccentDark}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary Button Style -->
    <Style x:Key="MISILSecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrushBgSurface}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource FontLabel}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusSm}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource BrushBgHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource BrushBgActive}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Card Container Style -->
    <Style x:Key="MISILCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushBgSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Text Input Style -->
    <Style x:Key="MISILTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BrushBgSurface}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{StaticResource BrushAccent}" />
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusSm}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
