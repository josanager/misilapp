<Window x:Class="MISILNative.Views.ContributionSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurar Aportación de Almacenamiento - MISIL"
        Height="540" Width="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BrushBgPrimary}">
    
    <Grid Margin="24">
        <!-- Main selection panel -->
        <StackPanel x:Name="PanelForm">
            <TextBlock Text="Aportar Almacenamiento" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,8" />
            <TextBlock x:Name="TxtAvailableDisk" Text="Disponible para compartir en Windows: calculando..." FontSize="13" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,20" TextWrapping="Wrap" />

            <!-- Presets -->
            <UniformGrid Columns="2" Rows="2" Margin="0,0,0,16">
                <Border x:Name="Preset10" Style="{StaticResource MISILCard}" Margin="0,0,6,8" Cursor="Hand" MouseLeftButtonUp="OnPresetClick" Tag="10">
                    <StackPanel>
                        <TextBlock Text="10 GB" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                        <TextBlock Text="Mínimo" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border x:Name="Preset50" Style="{StaticResource MISILCard}" Margin="6,0,0,8" Cursor="Hand" MouseLeftButtonUp="OnPresetClick" Tag="50">
                    <StackPanel>
                        <TextBlock Text="50 GB" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                        <TextBlock Text="Estándar" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border x:Name="Preset100" Style="{StaticResource MISILCard}" Margin="0,8,6,0" Cursor="Hand" MouseLeftButtonUp="OnPresetClick" Tag="100">
                    <StackPanel>
                        <TextBlock Text="100 GB" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                        <TextBlock Text="Avanzado" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border x:Name="Preset500" Style="{StaticResource MISILCard}" Margin="6,8,0,0" Cursor="Hand" MouseLeftButtonUp="OnPresetClick" Tag="500">
                    <StackPanel>
                        <TextBlock Text="500 GB" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                        <TextBlock Text="Capacidad alta" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Custom -->
            <TextBlock Text="O cantidad personalizada (GB)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,6,0,6" />
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtCustom" Style="{StaticResource MISILTextBox}" TextChanged="OnCustomChanged" />
                <TextBlock Text="GB" Grid.Column="1" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="10,0,0,0" />
            </Grid>

            <TextBlock x:Name="TxtError" Text="" FontSize="12" Foreground="{StaticResource BrushDanger}" Margin="0,-10,0,12" Visibility="Collapsed" />

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Cancelar" Style="{StaticResource MISILSecondaryButton}" Width="110" Margin="0,0,10,0" Click="OnCancelClick" />
                <Button x:Name="BtnSave" Content="Aplicar cuota" Style="{StaticResource MISILPrimaryButton}" Width="160" Click="OnSaveClick" />
            </StackPanel>
        </StackPanel>

        <!-- Preparing panel -->
        <StackPanel x:Name="PanelPreparing" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Configurando el nodo..." FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" TextAlignment="Center" Margin="0,0,0,12" />
            <ProgressBar x:Name="DialogProgress" Height="6" Width="380" Background="{StaticResource BrushBgSurface}" Foreground="{StaticResource BrushAccent}" BorderThickness="0" Margin="0,0,0,12" IsIndeterminate="True" />
            <TextBlock x:Name="TxtPreparingDetail" Text="Aplicando cambios y protegiendo claves..." FontSize="13" Foreground="{StaticResource BrushTextSecondary}" TextAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
