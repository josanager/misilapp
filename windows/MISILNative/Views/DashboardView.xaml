<UserControl x:Class="MISILNative.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushBgPrimary}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="30,0">
            <Grid VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Almacenamiento compartido" FontFamily="{StaticResource FontHeadline}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                    <TextBlock Text="Capacidad directa entre equipos MISIL de tu red" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,3,0,0" />
                </StackPanel>
                <Border HorizontalAlignment="Right" Background="{StaticResource BrushGlass}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="10,6">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="LocalStatusDot" Width="7" Height="7" Fill="{StaticResource BrushTextMuted}" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtLocalStatus" Text="INACTIVO" FontFamily="{StaticResource FontLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="30">
            <StackPanel MaxWidth="860" HorizontalAlignment="Left">
                <Border CornerRadius="18" BorderBrush="{StaticResource BrushAccentBorder}" BorderThickness="1" Padding="28" Margin="0,0,0,18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#40FF3737" Offset="0" />
                            <GradientStop Color="#20260000" Offset="0.58" />
                            <GradientStop Color="#0AFFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="CAPACIDAD MISIL DISPONIBLE" FontFamily="{StaticResource FontLabel}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" />
                                <TextBlock x:Name="TxtQuota" Text="0 B" FontFamily="{StaticResource FontHeadline}" FontSize="46" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,7,0,0" />
                                <TextBlock Text="Suma este PC y los equipos MISIL activos en la misma red Wi‑Fi." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button x:Name="BtnOpenFolder" Grid.Column="1" Content="Abrir carpeta" Style="{StaticResource MISILSecondaryButton}" Height="36" Padding="16,0" Click="OnOpenFolderClick" VerticalAlignment="Top" />
                        </Grid>
                        <StackPanel Grid.Row="1" Margin="0,25,0,0">
                            <ProgressBar x:Name="UsageProgress" Minimum="0" Maximum="100" Height="5" Background="#22FFFFFF" Foreground="{StaticResource BrushAccent}" BorderThickness="0" />
                            <Grid Margin="0,9,0,0">
                                <TextBlock x:Name="TxtUsed" Text="0 B utilizados" FontFamily="{StaticResource FontLabel}" FontSize="10" Foreground="{StaticResource BrushTextMuted}" />
                                <TextBlock x:Name="TxtAvailable" Text="0 B libres" FontFamily="{StaticResource FontLabel}" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource MISILCard}" Padding="18" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="RED P2P MISIL" FontFamily="{StaticResource FontLabel}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" />
                            <TextBlock x:Name="TxtNetworkStatus" Text="Buscando otros equipos MISIL…" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,7,0,0" TextWrapping="Wrap" />
                            <TextBlock x:Name="TxtPeers" Text="Este PC" FontFamily="{StaticResource FontLabel}" FontSize="10" Foreground="{StaticResource BrushTextMuted}" Margin="0,7,0,0" />
                        </StackPanel>
                        <Button x:Name="BtnTestStorage" Grid.Column="1" Content="Probar transferencia" Style="{StaticResource MISILPrimaryButton}" Padding="16,0" Click="OnTestStorageClick" />
                    </Grid>
                </Border>

                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource MISILCard}" Padding="18">
                        <StackPanel><TextBlock Text="CUOTA" FontFamily="{StaticResource FontLabel}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" /><TextBlock x:Name="TxtQuotaMetric" Text="0 B" FontFamily="{StaticResource FontHeadline}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,7,0,0" /></StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource MISILCard}" Padding="18">
                        <StackPanel><TextBlock Text="UTILIZADO" FontFamily="{StaticResource FontLabel}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" /><TextBlock x:Name="TxtUsedMetric" Text="0 B" FontFamily="{StaticResource FontHeadline}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,7,0,0" /></StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource MISILCard}" Padding="18">
                        <StackPanel><TextBlock Text="LIBRE" FontFamily="{StaticResource FontLabel}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" /><TextBlock x:Name="TxtFreeMetric" Text="0 B" FontFamily="{StaticResource FontHeadline}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" Margin="0,7,0,0" /></StackPanel>
                    </Border>
                </Grid>

                <Border x:Name="PanelActive" Style="{StaticResource MISILCard}" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Directorio privado" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource BrushTextPrimary}" />
                        <TextBlock x:Name="TxtStorageDirectory" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource BrushTextMuted}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Border x:Name="PanelInactive" Style="{StaticResource MISILCard}" Visibility="Collapsed" Padding="22" Margin="0,0,0,14">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="El almacenamiento está desactivado" FontFamily="{StaticResource FontHeadline}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock Text="Configura una cuota local para reservar espacio cifrado en este PC." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,5,0,0" />
                        </StackPanel>
                        <Button Content="Configurar cuota" Style="{StaticResource MISILPrimaryButton}" HorizontalAlignment="Right" Padding="16,0" Click="OnShareStorageClick" />
                    </Grid>
                </Border>

                <Border Background="{StaticResource BrushGlass}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                    <TextBlock Text="Conexión directa: ninguna nube intermedia. Los equipos deben estar activos en la misma red Wi‑Fi y permitir MISIL en el firewall privado." FontSize="10" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
