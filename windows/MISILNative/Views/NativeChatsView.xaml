<UserControl x:Class="MISILNative.Views.NativeChatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushBgPrimary}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="240" MaxWidth="330" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource BrushBgSecondary}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="16,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Chats" FontFamily="{StaticResource FontHeadline}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                        <TextBlock Text="Personas y modelos locales" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="1" Margin="8,10">
                    <Border x:Name="AgerbotContact" Background="Transparent" CornerRadius="10" Padding="12,10" Cursor="Hand" MouseLeftButtonUp="OnAgerbotContactClick">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" Background="{StaticResource BrushBgActive}" CornerRadius="10">
                                <TextBlock Text="AI" FontFamily="{StaticResource FontLabel}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource BrushAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Agerbot" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                                    <Border Background="{StaticResource BrushAccentGlass}" BorderBrush="{StaticResource BrushAccentBorder}" BorderThickness="1" CornerRadius="8" Padding="5,1" Margin="6,0,0,0">
                                        <TextBlock Text="LOCAL" FontFamily="{StaticResource FontLabel}" FontSize="7" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="TxtAgerbotPreview" Text="No instalado" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Ellipse x:Name="AgerbotStatusDot" Grid.Column="2" Width="7" Height="7" Fill="{StaticResource BrushTextMuted}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border x:Name="HumanContact" Background="{StaticResource BrushBgActive}" CornerRadius="10" Padding="12,10" Margin="0,4,0,0" Cursor="Hand" MouseLeftButtonUp="OnHumanContactClick">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" Background="{StaticResource BrushAccent}" CornerRadius="8">
                                <TextBlock Text="MI" FontWeight="Bold" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtActiveContact" Text="Nuevo contacto" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                                <TextBlock x:Name="TxtLastMessagePreview" Text="Sin mensajes" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <Border Grid.Row="2" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Background="{StaticResource BrushBgSurface}" Padding="14">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock x:Name="TxtConnectionStatus" Text="CONECTANDO" FontFamily="{StaticResource FontLabel}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Content="Copiar enlace" Style="{StaticResource MISILSecondaryButton}" Height="28" Padding="10,0" FontSize="10" HorizontalAlignment="Right" Click="OnCopyLinkClick" />
                        </Grid>
                        <TextBlock Text="TU IDENTIDAD" FontFamily="{StaticResource FontLabel}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                        <TextBlock x:Name="TxtPersonalLink" FontFamily="Consolas" FontSize="9" Foreground="{StaticResource BrushTextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,4,0,10" />
                        <TextBox x:Name="TxtContactInput" Style="{StaticResource MISILTextBox}" Height="34" FontSize="11" ToolTip="Enlace personal o nombre de usuario" />
                        <Button Content="Conectar contacto" Style="{StaticResource MISILPrimaryButton}" Height="32" Margin="0,8,0,0" FontSize="11" Click="OnConnectContactClick" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="60" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="20,0">
                <Grid VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock x:Name="TxtConversationTitle" Text="Mensajes" FontFamily="{StaticResource FontHeadline}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                        <TextBlock x:Name="TxtConversationSubtitle" Text="Pega el enlace personal de otro equipo" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button x:Name="BtnCancelGeneration" Content="Cancelar" Style="{StaticResource MISILSecondaryButton}" Height="30" Padding="12,0" FontSize="11" HorizontalAlignment="Right" Visibility="Collapsed" Click="OnCancelGenerationClick" />
                </Grid>
            </Border>

            <ScrollViewer x:Name="MessagesScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                <StackPanel>
                    <StackPanel x:Name="EmptyStatePanel" HorizontalAlignment="Center" Margin="0,80,0,0">
                        <TextBlock x:Name="TxtEmptyIcon" Text="✦" FontSize="34" Foreground="{StaticResource BrushAccent}" HorizontalAlignment="Center" Margin="0,0,0,12" />
                        <TextBlock x:Name="TxtEmptyTitle" Text="Conecta tu primer equipo" FontFamily="{StaticResource FontHeadline}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="TxtEmptyDetail" Text="Pega su enlace MISIL para enviar mensajes por Internet." FontSize="13" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        <Button x:Name="BtnStartAgerbot" Content="Iniciar Agerbot" Style="{StaticResource MISILPrimaryButton}" Margin="0,16,0,0" Visibility="Collapsed" Click="OnStartAgerbotClick" />
                    </StackPanel>
                    <ItemsControl x:Name="MessagesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Border x:Name="MessageBubble" Background="{StaticResource BrushBgActive}" CornerRadius="14" Padding="14,10" MaxWidth="460" HorizontalAlignment="Right">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SenderName}" FontFamily="{StaticResource FontLabel}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding Content}" FontSize="14" Foreground="{StaticResource BrushTextPrimary}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding FormattedTime}" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Right" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsOutgoing}" Value="False">
                                        <Setter TargetName="MessageBubble" Property="HorizontalAlignment" Value="Left" />
                                        <Setter TargetName="MessageBubble" Property="Background" Value="{StaticResource BrushBgSurface}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border x:Name="ThinkingBubble" Background="{StaticResource BrushBgSurface}" CornerRadius="14" Padding="13,10" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <ProgressBar Width="34" Height="3" IsIndeterminate="True" Foreground="{StaticResource BrushAccent}" BorderThickness="0" Margin="0,0,10,0" />
                            <TextBlock x:Name="TxtThinking" Text="Agerbot está pensando…" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="16,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtMessageInput" Style="{StaticResource MISILTextBox}" KeyDown="OnMessageInputKeyDown" />
                        <Button x:Name="BtnSend" Grid.Column="1" Style="{StaticResource MISILPrimaryButton}" Width="40" Height="40" Padding="0" Margin="10,0,0,0" Click="OnSendMessageClick"><TextBlock Text="↑" FontSize="18" FontWeight="Bold" /></Button>
                    </Grid>
                    <TextBlock x:Name="TxtMessagingError" FontSize="11" Foreground="{StaticResource BrushDanger}" Margin="0,7,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock x:Name="TxtAgerbotWarning" Text="Agerbot es experimental. No compartas información sensible." FontSize="10" Foreground="{StaticResource BrushTextMuted}" Margin="0,7,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
