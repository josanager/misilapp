<UserControl x:Class="MISILNative.Views.NativeChatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="800"
             Background="{StaticResource BrushBgPrimary}">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="220" MaxWidth="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Chat Rooms List -->
        <Border Grid.Column="0" Background="{StaticResource BrushBgSecondary}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="16,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Chats" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                        <TextBlock Text="Espacios de este PC" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,1,0,0" />
                    </StackPanel>
                </Border>

                <!-- Rooms -->
                <StackPanel Grid.Row="1" Margin="8,10">
                    <Border Background="{StaticResource BrushBgActive}" CornerRadius="10" Padding="12,10" Cursor="Hand">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" Background="{StaticResource BrushAccent}" CornerRadius="8">
                                <TextBlock Text="MI" FontWeight="Bold" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Mi espacio local" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                                <TextBlock x:Name="TxtLastMessagePreview" Text="Sin mensajes" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Bottom Relay Connect Button -->
                <Border Grid.Row="2" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Background="{StaticResource BrushBgSurface}" Padding="14,12" Cursor="Hand" MouseLeftButtonUp="OnRelaySetupClick">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtRelayIcon" Text="🌐" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock x:Name="TxtRelayStatus" Grid.Column="1" Text="Conectar MISIL Web" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Right Conversation Pane -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Conversation Header -->
            <Border Grid.Row="0" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="20,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Mi espacio local" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                    <TextBlock x:Name="TxtConversationSubtitle" Text="General · sólo en este PC" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,1,0,0" />
                </StackPanel>
            </Border>

            <!-- Messages List -->
            <ScrollViewer x:Name="MessagesScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                <StackPanel>
                    <!-- Empty state -->
                    <StackPanel x:Name="EmptyStatePanel" HorizontalAlignment="Center" Margin="0,80,0,0" Visibility="Visible">
                        <TextBlock Text="💬" FontSize="36" HorizontalAlignment="Center" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,12" />
                        <TextBlock Text="Todavía no hay mensajes" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center" />
                        <TextBlock Text="Esta conversación se guarda de forma segura en tu equipo Windows." FontSize="13" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Message Items Container -->
                    <ItemsControl x:Name="MessagesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Border Background="{StaticResource BrushBgActive}" CornerRadius="12" Padding="14,10" MaxWidth="440" HorizontalAlignment="Right">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SenderName}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" Visibility="{Binding SenderName, Converter={x:Null}}" Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding Content}" FontSize="14" Foreground="{StaticResource BrushTextPrimary}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding FormattedTime}" FontSize="10" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Right" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Input Bar -->
            <Border Grid.Row="2" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="16,12" Background="{StaticResource BrushBgPrimary}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtMessageInput" Style="{StaticResource MISILTextBox}" KeyDown="OnMessageInputKeyDown" />
                        <Button Grid.Column="1" Style="{StaticResource MISILPrimaryButton}" Width="40" Height="40" Padding="0" Margin="10,0,0,0" Cursor="Hand" Click="OnSendMessageClick">
                            <TextBlock Text="↑" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                    <TextBlock x:Name="TxtRelayError" Text="" FontSize="11" Foreground="{StaticResource BrushDanger}" Margin="0,6,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
