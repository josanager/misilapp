{
  "name": "misil",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n node,web -c red,white \"npm:dev:node\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:node": "node --watch local-node/server.mjs",
    "dev:cloud": "npm run build && wrangler pages dev dist --port 8788",
    "local:start": "node local-node/server.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "mac:test": "macos/MISILNative/scripts/test-native.sh",
    "mac:build": "macos/MISILNative/scripts/build-app.sh",
    "mac:dmg": "macos/MISILNative/scripts/build-dmg.sh",
    "win:build": "dotnet publish windows/MISILNative/MISILNative.csproj -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -o windows/MISILNative/dist",
    "preview": "vite preview",
    "test:local": "node --test local-node/*.test.mjs",
    "relay:migrate:local": "wrangler d1 migrations apply misil-relay --local",
    "relay:migrate:remote": "wrangler d1 migrations apply misil-relay --remote",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name=misil-web"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.577.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.13.1",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^8.1.5",
    "wrangler": "^4.70.0"
  }
}
